NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=elimara_session
CSRF_COOKIE_NAME=elimara_csrf
SESSION_TTL_HOURS=12
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-characters
PLATFORM_MFA_ENCRYPTION_KEY=replace-with-64-hex-characters
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/DATABASE?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/DATABASE?sslmode=require
