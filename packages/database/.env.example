# PostgreSQL connection strings for Neon serverless (least-privilege architecture)
# DATABASE_URL: Runtime pooled connection using the restricted 'elimara_app' role (port 6543 / pgbouncer)
DATABASE_URL=postgresql://elimara_app:REPLACE_WITH_APP_PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# DIRECT_URL: Direct non-pooled connection using the 'elimara_migrator' role (port 5432) for Prisma CLI migrations
DIRECT_URL=postgresql://elimara_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require

# Interactive transaction timeouts (in milliseconds)
DATABASE_TRANSACTION_MAX_WAIT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=10000

# Automated encrypted offsite backups (Cloudflare R2 / Amazon S3)
BACKUP_DATABASE_URL=postgresql://elimara_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters-256-bit-aes-key
BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=elimara-db-backups-private
BACKUP_S3_ACCESS_KEY_ID=replace-with-s3-or-r2-access-key-id
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-s3-or-r2-secret-access-key
BACKUP_S3_PREFIX=backups/
BACKUP_RETENTION_DAYS=30

