{
  "name": "@elimara/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:drift:check": "node scripts/drift-check.cjs",
    "db:roles:provision": "node scripts/provision-roles.cjs",
    "db:verify:integrity": "node scripts/verify-migration-integrity.cjs",
    "db:verify:restore": "node scripts/verify-restore-drill.cjs",
    "db:backup:create": "node scripts/backup-create.cjs",
    "db:backup:verify": "node scripts/backup-verify.cjs",
    "db:backup:restore": "node scripts/backup-restore.cjs",
    "db:benchmark:perf": "node scripts/run-performance-benchmark.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "6.19.0",
    "typescript": "^5.9.2"
  }
}
