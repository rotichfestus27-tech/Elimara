  term            Term                 @relation(fields: [schoolId, academicYearId, termId], references: [schoolId, academicYearId, id], onDelete: Restrict)
  academicClass   AcademicClass        @relation(fields: [schoolId, academicYearId, classId], references: [schoolId, academicYearId, id], onDelete: Restrict)
  createdBy       User                 @relation("FeeStructureCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items           FeeStructureItem[]
  charges         StudentFeeCharge[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, termId, classId, nameKey], map: "fee_structures_school_scope_name_key")
  @@index([schoolId, academicYearId, termId, classId, status], map: "fee_structures_school_scope_status_idx")
  @@map("fee_structures")
}

model FeeStructureItem {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  feeStructureId String       @map("fee_structure_id") @db.Uuid
  name           String       @db.VarChar(120)
  nameKey        String       @map("name_key") @db.VarChar(360)
  amount         Decimal      @db.Decimal(14, 2)
  position       Int
  feeStructure   FeeStructure @relation(fields: [schoolId, feeStructureId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, feeStructureId, nameKey], map: "fee_structure_items_school_structure_name_key")
  @@unique([schoolId, feeStructureId, position], map: "fee_structure_items_school_structure_position_key")
  @@map("fee_structure_items")
}

model StudentFinancialAccount {
  id          String                @id @default(uuid()) @db.Uuid
  schoolId    String                @map("school_id") @db.Uuid
  studentId   String                @map("student_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  school      School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student     Student               @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  charges     StudentFeeCharge[]
  payments    FinancialPayment[]
  allocations PaymentAllocation[]
  adjustments FinancialAdjustment[]

  @@unique([schoolId, id])
  @@unique([schoolId, studentId], map: "student_financial_accounts_school_student_key")
  @@map("student_financial_accounts")
}

model StudentFeeCharge {
  id                 String                  @id @default(uuid()) @db.Uuid
  schoolId           String                  @map("school_id") @db.Uuid
  accountId          String                  @map("account_id") @db.Uuid
  feeStructureId     String                  @map("fee_structure_id") @db.Uuid
  structureName      String                  @map("structure_name") @db.VarChar(120)
  totalAmount        Decimal                 @map("total_amount") @db.Decimal(14, 2)
  idempotencyKey     String                  @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String                  @map("request_fingerprint") @db.Char(64)
  createdByUserId    String                  @map("created_by_user_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  account            StudentFinancialAccount @relation(fields: [schoolId, accountId], references: [schoolId, id], onDelete: Restrict)
  feeStructure       FeeStructure            @relation(fields: [schoolId, feeStructureId], references: [schoolId, id], onDelete: Restrict)
  createdBy          User                    @relation("FinancialChargeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items              FeeChargeItem[]
  allocations        PaymentAllocation[]
  reversal           ChargeReversal?

  @@unique([schoolId, id])
  @@unique([schoolId, accountId, id], map: "student_fee_charges_school_account_id_key")
  @@unique([schoolId, accountId, idempotencyKey], map: "student_fee_charges_school_account_idempotency_key")
  @@index([schoolId, accountId, createdAt], map: "student_fee_charges_school_account_created_idx")
  @@map("student_fee_charges")
}

model FeeChargeItem {
  id       String           @id @default(uuid()) @db.Uuid
  schoolId String           @map("school_id") @db.Uuid
  chargeId String           @map("charge_id") @db.Uuid
  name     String           @db.VarChar(120)
  amount   Decimal          @db.Decimal(14, 2)
  position Int
  charge   StudentFeeCharge @relation(fields: [schoolId, chargeId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, chargeId, position], map: "fee_charge_items_school_charge_position_key")
  @@map("fee_charge_items")
}

model FinancialPayment {
  id                 String                  @id @default(uuid()) @db.Uuid
  schoolId           String                  @map("school_id") @db.Uuid
  accountId          String                  @map("account_id") @db.Uuid
  amount             Decimal                 @db.Decimal(14, 2)
  method             String                  @db.VarChar(40)
  reference          String?                 @db.VarChar(120)
  idempotencyKey     String                  @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String                  @map("request_fingerprint") @db.Char(64)
  receivedAt         DateTime                @default(now()) @map("received_at") @db.Timestamptz(6)
  recordedByUserId   String                  @map("recorded_by_user_id") @db.Uuid
  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  account            StudentFinancialAccount @relation(fields: [schoolId, accountId], references: [schoolId, id], onDelete: Restrict)
  recordedBy         User                    @relation("FinancialPaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  receipt            FinancialReceipt?
  allocations        PaymentAllocation[]
  refunds            PaymentRefund[]
  reconciliations    PaymentReconciliation[]

  @@unique([schoolId, id])
  @@unique([schoolId, accountId, id], map: "financial_payments_school_account_id_key")
  @@unique([schoolId, accountId, idempotencyKey], map: "financial_payments_school_account_idempotency_key")
  @@unique([schoolId, reference], map: "financial_payments_school_reference_key")
  @@index([schoolId, accountId, receivedAt], map: "financial_payments_school_account_received_idx")
  @@map("financial_payments")
}

model FinancialReceipt {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  paymentId String           @map("payment_id") @db.Uuid
  issuedAt  DateTime         @default(now()) @map("issued_at") @db.Timestamptz(6)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payment   FinancialPayment @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, paymentId], map: "financial_receipts_school_payment_key")
  @@map("financial_receipts")
}

model PaymentAllocation {
  id              String                      @id @default(uuid()) @db.Uuid
  schoolId        String                      @map("school_id") @db.Uuid
  accountId       String                      @map("account_id") @db.Uuid
  paymentId       String                      @map("payment_id") @db.Uuid
  chargeId        String                      @map("charge_id") @db.Uuid
  amount          Decimal                     @db.Decimal(14, 2)
  idempotencyKey  String                      @map("idempotency_key") @db.VarChar(128)
  createdByUserId String                      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  school          School                      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  account         StudentFinancialAccount     @relation(fields: [schoolId, accountId], references: [schoolId, id], onDelete: Restrict)
  payment         FinancialPayment            @relation(fields: [schoolId, accountId, paymentId], references: [schoolId, accountId, id], onDelete: Restrict)
  charge          StudentFeeCharge            @relation(fields: [schoolId, accountId, chargeId], references: [schoolId, accountId, id], onDelete: Restrict)
  createdBy       User                        @relation("PaymentAllocationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversals       PaymentAllocationReversal[]

  @@unique([schoolId, id])
  @@unique([schoolId, accountId, id], map: "payment_allocations_school_account_id_key")
  @@unique([schoolId, paymentId, idempotencyKey], map: "payment_allocations_school_payment_idempotency_key")
  @@index([schoolId, chargeId], map: "payment_allocations_school_charge_idx")
  @@map("payment_allocations")
}

model PaymentAllocationReversal {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @map("school_id") @db.Uuid
  allocationId   String            @map("allocation_id") @db.Uuid
  amount         Decimal           @db.Decimal(14, 2)
  reason         String            @db.VarChar(500)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(128)
  actorUserId    String            @map("actor_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  allocation     PaymentAllocation @relation(fields: [schoolId, allocationId], references: [schoolId, id], onDelete: Restrict)
  actor          User              @relation("PaymentAllocationReversalActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, allocationId, idempotencyKey], map: "payment_allocation_reversals_school_allocation_idempotency_key")
  @@index([schoolId, allocationId], map: "payment_allocation_reversals_school_allocation_idx")
  @@map("payment_allocation_reversals")
}

model ChargeReversal {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  chargeId       String           @map("charge_id") @db.Uuid
  amount         Decimal          @db.Decimal(14, 2)
  reason         String           @db.VarChar(500)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(128)
  actorUserId    String           @map("actor_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  charge         StudentFeeCharge @relation(fields: [schoolId, chargeId], references: [schoolId, id], onDelete: Restrict)
  actor          User             @relation("ChargeReversalActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, chargeId], map: "charge_reversals_school_charge_key")
  @@unique([schoolId, idempotencyKey], map: "charge_reversals_school_idempotency_key")
  @@map("charge_reversals")
}

model FinancialAdjustment {
  id             String                       @id @default(uuid()) @db.Uuid
  schoolId       String                       @map("school_id") @db.Uuid
  accountId      String                       @map("account_id") @db.Uuid
  direction      FinancialAdjustmentDirection
  amount         Decimal                      @db.Decimal(14, 2)
  reason         String                       @db.VarChar(500)
  idempotencyKey String                       @map("idempotency_key") @db.VarChar(128)
  actorUserId    String                       @map("actor_user_id") @db.Uuid
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  school         School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  account        StudentFinancialAccount      @relation(fields: [schoolId, accountId], references: [schoolId, id], onDelete: Restrict)
  actor          User                         @relation("FinancialAdjustmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, accountId, idempotencyKey], map: "financial_adjustments_school_account_idempotency_key")
  @@index([schoolId, accountId, createdAt], map: "financial_adjustments_school_account_created_idx")
  @@map("financial_adjustments")
}

model PaymentRefund {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  paymentId      String           @map("payment_id") @db.Uuid
  amount         Decimal          @db.Decimal(14, 2)
  reference      String           @db.VarChar(120)
  reason         String           @db.VarChar(500)
  idempotencyKey String           @map("idempotency_key") @db.VarChar(128)
  actorUserId    String           @map("actor_user_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payment        FinancialPayment @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)
  actor          User             @relation("PaymentRefundActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, paymentId, idempotencyKey], map: "payment_refunds_school_payment_idempotency_key")
  @@unique([schoolId, reference], map: "payment_refunds_school_reference_key")
  @@index([schoolId, paymentId, createdAt], map: "payment_refunds_school_payment_created_idx")
  @@map("payment_refunds")
}

model PaymentReconciliation {
  id                 String                       @id @default(uuid()) @db.Uuid
  schoolId           String                       @map("school_id") @db.Uuid
  paymentId          String                       @map("payment_id") @db.Uuid
  statementAmount    Decimal                      @map("statement_amount") @db.Decimal(14, 2)
  statementReference String?                      @map("statement_reference") @db.VarChar(120)
  note               String                       @db.VarChar(500)
  outcome            PaymentReconciliationOutcome
  idempotencyKey     String                       @map("idempotency_key") @db.VarChar(128)
  actorUserId        String                       @map("actor_user_id") @db.Uuid
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  school             School                       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payment            FinancialPayment             @relation(fields: [schoolId, paymentId], references: [schoolId, id], onDelete: Restrict)
  actor              User                         @relation("PaymentReconciliationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, paymentId, idempotencyKey], map: "payment_reconciliations_school_payment_idempotency_key")
  @@index([schoolId, outcome, createdAt], map: "payment_reconciliations_school_outcome_created_idx")
  @@map("payment_reconciliations")
}

model Notification {
  id                 String                     @id @default(uuid()) @db.Uuid
  schoolId           String                     @map("school_id") @db.Uuid
  recipientUserId    String                     @map("recipient_user_id") @db.Uuid
  eventKey           String                     @map("event_key") @db.VarChar(180)
  requestFingerprint String                     @map("request_fingerprint") @db.Char(64)
  channel            NotificationChannel
  title              String                     @db.VarChar(120)
  body               String                     @db.Text
  status             NotificationDeliveryStatus @default(QUEUED)
  attemptCount       Int                        @default(0) @map("attempt_count")
  nextAttemptAt      DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptAt      DateTime?                  @map("last_attempt_at") @db.Timestamptz(6)
  sentAt             DateTime?                  @map("sent_at") @db.Timestamptz(6)
  deliveredAt        DateTime?                  @map("delivered_at") @db.Timestamptz(6)
  readAt             DateTime?                  @map("read_at") @db.Timestamptz(6)
  providerMessageId  String?                    @map("provider_message_id") @db.VarChar(180)
  failureCode        String?                    @map("failure_code") @db.VarChar(80)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  membership         SchoolMembership           @relation(fields: [schoolId, recipientUserId], references: [schoolId, userId], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, eventKey, recipientUserId, channel], map: "notifications_school_event_recipient_channel_key")
  @@index([schoolId, recipientUserId, createdAt], map: "notifications_school_recipient_created_idx")
  @@index([status, nextAttemptAt, createdAt], map: "notifications_queue_status_next_attempt_idx")
  @@map("notifications")
}
