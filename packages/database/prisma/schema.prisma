generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  DEACTIVATED
  SUSPENDED
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AcademicRecordStatus {
  ACTIVE
  INACTIVE
}

enum AdmissionApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
  ADMITTED
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceRegisterType {
  STUDENT_DAILY
  STUDENT_LESSON
  STAFF_DAILY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_DEPARTURE
}

enum AttendanceRegisterStatus {
  OPEN
  FINALIZED
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
}

enum AssessmentStatus {
  DRAFT
  OPEN
  MODERATION
  FINALIZED
  PUBLISHED
}

enum FinancialAdjustmentDirection {
  DEBIT
  CREDIT
}

enum PaymentReconciliationOutcome {
  MATCHED
  EXCEPTION
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  QUEUED
  RETRYING
  SENT
  DELIVERED
  FAILED
}

enum LibraryReservationStatus {
  QUEUED
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

enum AccountTokenPurpose {
  PASSWORD_RESET
  ACCOUNT_ACTIVATION
}

model User {
  id                            String                            @id @default(uuid()) @db.Uuid
  email                         String                            @unique @db.VarChar(320)
  passwordHash                  String?                           @map("password_hash") @db.VarChar(255)
  status                        UserStatus                        @default(PENDING)
  emailVerifiedAt               DateTime?                         @map("email_verified_at") @db.Timestamptz(6)
  createdAt                     DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions                      UserSession[]
  memberships                   SchoolMembership[]
  accountTokens                 AccountActionToken[]
  platformAssignment            PlatformAdminAssignment?
  auditEvents                   SecurityAuditEvent[]              @relation("AuditActor")
  grantedPlatform               PlatformAdminAssignment[]         @relation("PlatformGrantor")
  assignedSchoolSubscriptions    SchoolSubscription[]
  createdAdmissionApplications  AdmissionApplication[]            @relation("AdmissionApplicationCreator")
  assignedStudentPlacements     StudentPlacement[]                @relation("StudentPlacementAssigner")
  admissionApplicationEvents    AdmissionApplicationStatusEvent[]
  studentStatusEvents           StudentStatusEvent[]
  studentProfileRevisions       StudentProfileRevision[]
  guardianProfileRevisions      GuardianProfileRevision[]
  staffStatusEvents             StaffStatusEvent[]
  createdAttendanceRegisters    AttendanceRegister[]              @relation("AttendanceRegisterCreator")
  finalizedAttendanceRegisters  AttendanceRegister[]              @relation("AttendanceRegisterFinalizer")
  markedAttendanceRecords       AttendanceRecord[]                @relation("AttendanceRecordMarker")
  attendanceRecordRevisions     AttendanceRecordRevision[]        @relation("AttendanceRecordRevisionActor")
  timetableEvents               TimetableEvent[]                  @relation("TimetableEventActor")
  gradingScalesCreated          GradingScale[]                    @relation("GradingScaleCreator")
  assessmentsCreated            Assessment[]                      @relation("AssessmentCreator")
  assessmentsFinalized          Assessment[]                      @relation("AssessmentFinalizer")
  assessmentsPublished          Assessment[]                      @relation("AssessmentPublisher")
  assessmentEvents              AssessmentEvent[]                 @relation("AssessmentEventActor")
  assessmentResultsEntered      AssessmentResult[]                @relation("AssessmentResultEnteredBy")
  assessmentResultsUpdated      AssessmentResult[]                @relation("AssessmentResultUpdatedBy")
  assessmentResultRevisions     AssessmentResultRevision[]        @relation("AssessmentResultRevisionActor")
  createdFeeStructures          FeeStructure[]                    @relation("FeeStructureCreator")
  createdFinancialCharges       StudentFeeCharge[]                @relation("FinancialChargeCreator")
  recordedFinancialPayments     FinancialPayment[]                @relation("FinancialPaymentRecorder")
  createdPaymentAllocations     PaymentAllocation[]               @relation("PaymentAllocationCreator")
  reversedPaymentAllocations    PaymentAllocationReversal[]       @relation("PaymentAllocationReversalActor")
  reversedFinancialCharges      ChargeReversal[]                  @relation("ChargeReversalActor")
  createdFinancialAdjustments   FinancialAdjustment[]             @relation("FinancialAdjustmentActor")
  recordedPaymentRefunds        PaymentRefund[]                   @relation("PaymentRefundActor")
  createdPaymentReconciliations PaymentReconciliation[]           @relation("PaymentReconciliationActor")
  libraryPoliciesUpdated        LibraryPolicy[]

  @@map("users")
}

model School {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @db.VarChar(200)
  contactEmail               String?                     @map("contact_email") @db.VarChar(320)
  contactPhone               String?                     @map("contact_phone") @db.VarChar(40)
  status                     SchoolStatus                @default(ACTIVE)
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches                   Branch[]
  memberships                SchoolMembership[]
  roles                      SchoolRole[]
  auditEvents                SecurityAuditEvent[]
  subscriptions              SchoolSubscription[]
  academicYears              AcademicYear[]
  classes                    AcademicClass[]
  subjects                   Subject[]
  classSubjects              ClassSubjectAssignment[]
  admissionApplications      AdmissionApplication[]
  guardians                  Guardian[]
  students                   Student[]
  admissionNumberCounters    AdmissionNumberCounter[]
  studentGuardians           StudentGuardian[]
  studentPlacements          StudentPlacement[]
  staffDepartments           StaffDepartment[]
  staff                      Staff[]
  staffEmployments           StaffEmployment[]
  staffClassAssignments      StaffClassAssignment[]
  staffSubjectAssignments    StaffSubjectAssignment[]
  attendanceReasons          AttendanceAbsenceReason[]
  attendanceRegisters        AttendanceRegister[]
  attendanceRecords          AttendanceRecord[]
  attendanceRevisions        AttendanceRecordRevision[]
  timetablePeriods           TimetablePeriod[]
  rooms                      SchoolRoom[]
  staffAvailability          StaffAvailabilityWindow[]
  timetables                 Timetable[]
  timetableLessons           TimetableLesson[]
  gradingScales              GradingScale[]
  assessments                Assessment[]
  assessmentResults          AssessmentResult[]
  assessmentEvents           AssessmentEvent[]
  assessmentResultRevisions  AssessmentResultRevision[]
  feeStructures              FeeStructure[]
  financialAccounts          StudentFinancialAccount[]
  financialCharges           StudentFeeCharge[]
  financialPayments          FinancialPayment[]
  financialReceipts          FinancialReceipt[]
  paymentAllocations         PaymentAllocation[]
  paymentAllocationReversals PaymentAllocationReversal[]
  chargeReversals            ChargeReversal[]
  financialAdjustments       FinancialAdjustment[]
  paymentRefunds             PaymentRefund[]
  paymentReconciliations     PaymentReconciliation[]
  libraryCategories          LibraryCategory[]
  libraryItems               LibraryItem[]
  libraryCopies              LibraryCopy[]
  libraryPolicy              LibraryPolicy?
  libraryLoans               LibraryLoan[]
  libraryReservations        LibraryReservation[]

  @@map("schools")
}

model AcademicYear {
  id                     String                  @id @default(uuid()) @db.Uuid
  schoolId               String                  @map("school_id") @db.Uuid
  name                   String                  @db.VarChar(100)
  nameKey                String                  @map("name_key") @db.VarChar(360)
  startsOn               DateTime                @map("starts_on") @db.Date
  endsOn                 DateTime                @map("ends_on") @db.Date
  status                 AcademicRecordStatus    @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  terms                  Term[]
  classes                AcademicClass[]
  admittedStudents       Student[]
  admissionNumberCounter AdmissionNumberCounter?
  studentPlacements      StudentPlacement[]
  timetables             Timetable[]
  attendanceRegisters    AttendanceRegister[]
  assessments            Assessment[]
  feeStructures          FeeStructure[]

  @@unique([schoolId, id])
  @@unique([schoolId, nameKey], map: "academic_years_school_id_name_key")
  @@index([schoolId, status, startsOn], map: "academic_years_school_status_starts_on_idx")
  @@map("academic_years")
}

model Term {
  id             String               @id @default(uuid()) @db.Uuid
  schoolId       String               @map("school_id") @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  name           String               @db.VarChar(100)
  nameKey        String               @map("name_key") @db.VarChar(360)
  startsOn       DateTime             @map("starts_on") @db.Date
  endsOn         DateTime             @map("ends_on") @db.Date
  status         AcademicRecordStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicYear   AcademicYear         @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)
  assessments    Assessment[]
  feeStructures  FeeStructure[]

  @@unique([schoolId, academicYearId, id], map: "terms_school_year_id_key")
  @@unique([schoolId, academicYearId, nameKey], map: "terms_school_id_academic_year_id_name_key")
  @@index([schoolId, academicYearId, status, startsOn], map: "terms_school_year_status_starts_on_idx")
  @@map("terms")
}

model AcademicClass {
  id                  String                   @id @default(uuid()) @db.Uuid
  schoolId            String                   @map("school_id") @db.Uuid
  academicYearId      String                   @map("academic_year_id") @db.Uuid
  name                String                   @db.VarChar(100)
  nameKey             String                   @map("name_key") @db.VarChar(360)
  status              AcademicRecordStatus     @default(ACTIVE)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  school              School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear        AcademicYear             @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)
  streams             ClassStream[]
  subjects            ClassSubjectAssignment[]
  studentPlacements   StudentPlacement[]
  staffAssignments    StaffClassAssignment[]
  attendanceRegisters AttendanceRegister[]
  timetableLessons    TimetableLesson[]
  libraryLoans        LibraryLoan[]
  libraryReservations LibraryReservation[]
  assessments         Assessment[]
  feeStructures       FeeStructure[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, id], map: "academic_classes_school_year_id_key")
  @@unique([schoolId, academicYearId, nameKey], map: "academic_classes_school_id_academic_year_id_name_key")
  @@index([schoolId, academicYearId, status], map: "academic_classes_school_year_status_idx")
  @@map("academic_classes")
}

model ClassStream {
  id                  String                 @id @default(uuid()) @db.Uuid
  schoolId            String                 @map("school_id") @db.Uuid
  classId             String                 @map("class_id") @db.Uuid
  name                String                 @db.VarChar(100)
  nameKey             String                 @map("name_key") @db.VarChar(360)
  status              AcademicRecordStatus   @default(ACTIVE)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  class               AcademicClass          @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  studentPlacements   StudentPlacement[]
  staffAssignments    StaffClassAssignment[]
  attendanceRegisters AttendanceRegister[]
  timetableLessons    TimetableLesson[]
  assessments         Assessment[]

  @@unique([schoolId, id])
  @@unique([schoolId, classId, id], map: "class_streams_school_class_id_key")
  @@unique([schoolId, classId, nameKey], map: "class_streams_school_id_class_id_name_key")
  @@index([schoolId, classId, status], map: "class_streams_school_class_status_idx")
  @@map("class_streams")
}

model Subject {
  id        String                   @id @default(uuid()) @db.Uuid
  schoolId  String                   @map("school_id") @db.Uuid
  name      String                   @db.VarChar(120)
  nameKey   String                   @map("name_key") @db.VarChar(360)
  status    AcademicRecordStatus     @default(ACTIVE)
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  school    School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classes   ClassSubjectAssignment[]

  @@unique([schoolId, id])
  @@unique([schoolId, nameKey], map: "subjects_school_id_name_key")
  @@index([schoolId, status, name], map: "subjects_school_status_name_idx")
  @@map("subjects")
}

model ClassSubjectAssignment {
  id               String                   @id @default(uuid()) @db.Uuid
  schoolId         String                   @map("school_id") @db.Uuid
  classId          String                   @map("class_id") @db.Uuid
  subjectId        String                   @map("subject_id") @db.Uuid
  status           AcademicRecordStatus     @default(ACTIVE)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  school           School                   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class            AcademicClass            @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  subject          Subject                  @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict)
  staffAssignments StaffSubjectAssignment[]
  timetableLessons TimetableLesson[]
  assessments      Assessment[]

  @@unique([schoolId, id])
  @@unique([schoolId, classId, id], map: "class_subject_assignments_school_class_id_key")
  @@unique([schoolId, classId, subjectId], map: "class_subject_assignments_school_class_subject_key")
  @@index([schoolId, classId, status], map: "class_subject_assignments_school_class_status_idx")
  @@index([schoolId, subjectId, status], map: "class_subject_assignments_school_subject_status_idx")
  @@map("class_subject_assignments")
}

model StaffDepartment {
  id        String               @id @default(uuid()) @db.Uuid
  schoolId  String               @map("school_id") @db.Uuid
  name      String               @db.VarChar(120)
  nameKey   String               @map("name_key") @db.VarChar(360)
  status    AcademicRecordStatus @default(ACTIVE)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff     Staff[]

  @@unique([schoolId, id])
  @@unique([schoolId, nameKey], map: "staff_departments_school_name_key")
  @@index([schoolId, status, name], map: "staff_departments_school_status_name_idx")
  @@map("staff_departments")
}

model Staff {
  id                  String                    @id @default(uuid()) @db.Uuid
  schoolId            String                    @map("school_id") @db.Uuid
  staffNumber         String                    @map("staff_number") @db.VarChar(80)
  staffNumberKey      String                    @map("staff_number_key") @db.VarChar(80)
  givenName           String                    @map("given_name") @db.VarChar(100)
  middleName          String?                   @map("middle_name") @db.VarChar(100)
  familyName          String                    @map("family_name") @db.VarChar(100)
  contactEmail        String?                   @map("contact_email") @db.VarChar(320)
  contactPhone        String?                   @map("contact_phone") @db.VarChar(40)
  positionTitle       String                    @map("position_title") @db.VarChar(120)
  departmentId        String?                   @map("department_id") @db.Uuid
  userId              String?                   @map("user_id") @db.Uuid
  status              StaffStatus               @default(ACTIVE)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  school              School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  department          StaffDepartment?          @relation(fields: [schoolId, departmentId], references: [schoolId, id], onDelete: Restrict)
  membership          SchoolMembership?         @relation(fields: [schoolId, userId], references: [schoolId, userId], onDelete: Restrict)
  employments         StaffEmployment[]
  statusHistory       StaffStatusEvent[]
  classAssignments    StaffClassAssignment[]
  subjectAssignments  StaffSubjectAssignment[]
  attendanceRecords   AttendanceRecord[]
  availabilityWindows StaffAvailabilityWindow[]
  timetableLessons    TimetableLesson[]
  libraryLoans        LibraryLoan[]
  libraryReservations LibraryReservation[]

  @@unique([schoolId, id])
  @@unique([schoolId, staffNumberKey], map: "staff_school_staff_number_key")
  @@unique([schoolId, userId], map: "staff_school_user_id_key")
  @@index([schoolId, status, familyName, givenName], map: "staff_school_status_name_idx")
  @@index([schoolId, departmentId, status], map: "staff_school_department_status_idx")
  @@map("staff")
}

model StaffEmployment {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  positionTitle String    @map("position_title") @db.VarChar(120)
  startsOn      DateTime  @map("starts_on") @db.Date
  endsOn        DateTime? @map("ends_on") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff         Staff     @relation(fields: [schoolId, staffId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, staffId, startsOn], map: "staff_employments_school_staff_starts_on_idx")
  @@map("staff_employments")
}

model StaffStatusEvent {
  id          String       @id @default(uuid()) @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  staffId     String       @map("staff_id") @db.Uuid
  actorUserId String       @map("actor_user_id") @db.Uuid
  fromStatus  StaffStatus? @map("from_status")
  toStatus    StaffStatus  @map("to_status")
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId   String?      @map("request_id") @db.VarChar(80)
  staff       Staff        @relation(fields: [schoolId, staffId], references: [schoolId, id], onDelete: Restrict)
  actor       User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([schoolId, staffId, occurredAt], map: "staff_status_events_school_staff_occurred_at_idx")
  @@map("staff_status_events")
}

model StaffClassAssignment {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  staffId       String        @map("staff_id") @db.Uuid
  classId       String        @map("class_id") @db.Uuid
  streamId      String?       @map("stream_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  endedAt       DateTime?     @map("ended_at") @db.Timestamptz(6)
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff         Staff         @relation(fields: [schoolId, staffId], references: [schoolId, id], onDelete: Restrict)
  academicClass AcademicClass @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  stream        ClassStream?  @relation(fields: [schoolId, classId, streamId], references: [schoolId, classId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, staffId, createdAt], map: "staff_class_assignments_school_staff_created_at_idx")
  @@index([schoolId, classId, streamId], map: "staff_class_assignments_school_class_stream_idx")
  @@map("staff_class_assignments")
}

model StaffSubjectAssignment {
  id                       String                 @id @default(uuid()) @db.Uuid
  schoolId                 String                 @map("school_id") @db.Uuid
  staffId                  String                 @map("staff_id") @db.Uuid
  classSubjectAssignmentId String                 @map("class_subject_assignment_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  endedAt                  DateTime?              @map("ended_at") @db.Timestamptz(6)
  school                   School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  staff                    Staff                  @relation(fields: [schoolId, staffId], references: [schoolId, id], onDelete: Restrict)
  classSubjectAssignment   ClassSubjectAssignment @relation(fields: [schoolId, classSubjectAssignmentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, staffId, createdAt], map: "staff_subject_assignments_school_staff_created_at_idx")
  @@index([schoolId, classSubjectAssignmentId], map: "staff_subject_assignments_school_class_subject_idx")
  @@map("staff_subject_assignments")
}

model AttendanceAbsenceReason {
  id        String               @id @default(uuid()) @db.Uuid
  schoolId  String               @map("school_id") @db.Uuid
  name      String               @db.VarChar(100)
  nameKey   String               @map("name_key") @db.VarChar(300)
  status    AcademicRecordStatus @default(ACTIVE)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  records   AttendanceRecord[]

  @@unique([schoolId, id])
  @@unique([schoolId, nameKey], map: "attendance_absence_reasons_school_name_key")
  @@index([schoolId, status, name], map: "attendance_absence_reasons_school_status_name_idx")
  @@map("attendance_absence_reasons")
}

model GradingScale {
  id              String               @id @default(uuid()) @db.Uuid
  schoolId        String               @map("school_id") @db.Uuid
  name            String               @db.VarChar(100)
  nameKey         String               @map("name_key") @db.VarChar(300)
  status          AcademicRecordStatus @default(ACTIVE)
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation("GradingScaleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  bands           GradingBand[]
  assessments     Assessment[]

  @@unique([schoolId, id])
  @@unique([schoolId, nameKey], map: "grading_scales_school_name_key")
  @@index([schoolId, status, name], map: "grading_scales_school_status_name_idx")
  @@map("grading_scales")
}

model GradingBand {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  gradingScaleId String       @map("grading_scale_id") @db.Uuid
  code           String       @db.VarChar(24)
  label          String       @db.VarChar(100)
  lowerPercent   Decimal      @map("lower_percent") @db.Decimal(5, 2)
  upperPercent   Decimal      @map("upper_percent") @db.Decimal(5, 2)
  position       Int
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  gradingScale   GradingScale @relation(fields: [schoolId, gradingScaleId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@unique([schoolId, gradingScaleId, code], map: "grading_bands_school_scale_code_key")
  @@unique([schoolId, gradingScaleId, position], map: "grading_bands_school_scale_position_key")
  @@index([schoolId, gradingScaleId, lowerPercent], map: "grading_bands_school_scale_lower_idx")
  @@map("grading_bands")
}

model Assessment {
  id                       String                 @id @default(uuid()) @db.Uuid
  schoolId                 String                 @map("school_id") @db.Uuid
  academicYearId           String                 @map("academic_year_id") @db.Uuid
  termId                   String                 @map("term_id") @db.Uuid
  classId                  String                 @map("class_id") @db.Uuid
  streamId                 String?                @map("stream_id") @db.Uuid
  classSubjectAssignmentId String                 @map("class_subject_assignment_id") @db.Uuid
  gradingScaleId           String                 @map("grading_scale_id") @db.Uuid
